# ---- Server ----
PORT=8000
NODE_ENV=development

# Comma-separated list of front-end origins allowed to call the API.
# Vite dev servers: admin 5173, trainer 5174, client 5175 (adjust to your setup).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Database ----
# Local MongoDB:      mongodb://127.0.0.1:27017/fittrack
# MongoDB Atlas:      mongodb+srv://<user>:<pass>@<cluster>/fittrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# ---- Auth (JWT) ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seeding ----
# When "true", `npm run seed` also creates demo admin/trainer/client accounts.
SEED_DEMO=true
# Default password given to every demo account created by the seeder.
SEED_DEMO_PASSWORD=demo1234

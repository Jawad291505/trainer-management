# ---- Server ----
PORT=8000
NODE_ENV=development

# Comma-separated list of front-end origins allowed to call the API.
# Vite dev servers: admin 5173, trainer 5174, client 5175 (adjust to your setup).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Database ----
# Local MongoDB:      mongodb://127.0.0.1:27017/fittrack
# MongoDB Atlas:      mongodb+srv://<user>:<pass>@<cluster>/fittrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# ---- Auth (JWT) ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seeding ----
# When "true", `npm run seed` also creates demo admin/trainer/client accounts.
SEED_DEMO=true
# Default password given to every demo account created by the seeder.
SEED_DEMO_PASSWORD=demo1234

# ---- Resend (transactional invite emails) ----
# https://resend.com/api-keys — create a key with "Sending access".
RESEND_API_KEY=
# Must be on a domain you've verified in Resend (Domains tab), e.g.
# "FitTrack <onboarding@yourdomain.com>". Left unset, invite emails are logged
# to the console instead of sent, and the API returns the temp password so an
# admin can share it manually — safe for local dev, not for production.
EMAIL_FROM=FitTrack <onboarding@yourdomain.com>

# ---- Invitation flow ----
# How many days a temp password stays valid before an admin must resend it.
INVITE_EXPIRY_DAYS=7
# Where each portal is hosted — linked from invite emails.
ADMIN_PORTAL_URL=http://localhost:5173
TRAINER_PORTAL_URL=http://localhost:5174
CLIENT_PORTAL_URL=http://localhost:5175

# ---- Member self-signup: email OTP ----
# How many minutes a signup verification code stays valid before it must be resent.
OTP_EXPIRY_MINUTES=10

# ---- Cloudinary (Member payment-proof screenshot uploads) ----
# https://console.cloudinary.com -> Dashboard, "API Environment variable" panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Organization bank details (shown on the Member payment-submission page) ----
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BRANCH=

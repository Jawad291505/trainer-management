# Copy to .env and fill in. .env is gitignored.

# --- Database (Neon) ---
# Neon dashboard -> Connection Details -> "Connection string".
# Use the POOLED host (has "-pooler" in it) for the app.
# Driver must be psycopg (v3): postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Auth ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP (email verification + password reset) ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email (Resend) ---
# Leave RESEND_API_KEY blank to skip real sending — the OTP is logged to the
# console instead, so the whole flow works with no account.
# Get a key at https://resend.com -> API Keys. Test sender needs no domain setup.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=FitTrack

# --- CORS ---
# Comma-separated origins allowed to call the API (the three Vite dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Misc ---
ENV=local

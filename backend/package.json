{
  "name": "fittrack-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + MongoDB backend for the FitTrack trainer-management platform (Admin / Trainer / Client portals).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeders/seed.js",
    "seed:master": "node src/seeders/seed.js --only=master",
    "seed:demo": "node src/seeders/seed.js --only=demo",
    "seed:users": "node src/seeders/seedUsers.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  }
}
